# Coolify'daki PostgreSQL kaynağının "Internal URL"si
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ytmusic
# openssl rand -hex 32 ile üret, eklentiye de aynısını gir
INGEST_TOKEN=
# İstatistiklerde saat/gün hesabı için
TZ_NAME=Europe/Istanbul
PORT=3000
# Ziyaret bildirimi (isteğe bağlı): ntfy uygulamasında abone olacağın gizli konu adı.
# Tahmin edilemez olmalı: openssl rand -hex 12  -> "ibaransel-ziyaret-<çıktı>"
NTFY_TOPIC=
# Kendi ntfy sunucun varsa değiştir
NTFY_URL=https://ntfy.sh
# İsteğe bağlı: konuyu ntfy hesabınla korursan (access token). Konu adını bilen biri yine de
# sahte bildirim gönderemez ve okuyamaz.
NTFY_TOKEN=
# Bildirimlerdeki linkin ve izin verilen Origin'in site adresi
SITE_URL=https://ibaransel.com
# İsteğe bağlı: IP'den şehir ve kurum (örn. "Ankara, TR (Microsoft)"). MaxMind'ın ücretsiz GeoLite2 veritabanı
# dosyalarının yolu (Coolify'da kalıcı depolama bağla). Boşsa saat diliminden şehir tahmini kullanılır.
# IP üçüncü tarafa gitmez, hiçbir yere yazılmaz.
GEOIP_CITY_DB=
GEOIP_ASN_DB=
# Site asistanı Cooper (isteğe bağlı): boşsa /api/chat "uyuyor" cevabı verir.
# Anahtarı yalnızca Coolify ortam değişkenlerine koy; sohbete/koda/siteye asla yazma.
OPENAI_API_KEY=
# Varsayılan gpt-4o. Daha ucuz/hızlı olsun istersen gpt-4o-mini (yaklaşık 15 kat ucuz, daha az zeki).
OPENAI_MODEL=gpt-4o
# Acil kapatma düğmesi: false yapıp yeniden başlat
CHAT_ENABLED=true
# Yerel geliştirme için ek izinli Origin'ler (virgülle), örn. http://localhost:3000
CHAT_EXTRA_ORIGINS=
